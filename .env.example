# Neon Postgres connection string (added automatically by the Vercel Neon integration)
DATABASE_URL=

# Vercel sends this as a Bearer token to cron routes. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional settings
NEXT_PUBLIC_APP_NAME=Community Watch Map
NEXT_PUBLIC_MAP_CENTER=37.8044,-122.2712
NEXT_PUBLIC_MAP_ZOOM=12
# Shown in the header so people call trained responders instead of acting alone
NEXT_PUBLIC_HOTLINE_LABEL=Rapid response hotline
NEXT_PUBLIC_HOTLINE_NUMBER=
# Days to keep reports (counted from when the activity happened) before the daily cleanup deletes them
RETENTION_DAYS=30
